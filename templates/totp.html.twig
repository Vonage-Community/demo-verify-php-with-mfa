{% block scripts %}
    <script>
        const apiHost = window.location.origin;
        const verifyCode = (code) => {
            const headers = new Headers();
            headers.append('Content-Type', 'application/json');
            console.log('Verify TOTP', {code: code})
            msg.classList.add('d-none')
            success.classList.add('d-none')
            fetch(
                `${apiHost}/verify-totp`,
                {
                    method: 'POST',
                    body: JSON.stringify({
                        code: code,
                    }),
                    headers: headers,
                }
            ).then(async (res) => {
                if (res.status === 200) {
                    console.log('Code Verified')
                    return;
                }

                const { error  } = await res.json();
                msg.classList.remove('d-none');
                msg.innerHTML = error;
                throw error;
            }).catch((e) => {
                console.error(e);
            })
        };

        const handleButtonClickEvent = (event) => {
            const {target} = event;

            // Handle web components
            if (target.tagName.includes('-')) {
                return;
            }

            if (target.tagName === 'A' || target.tagName === 'INPUT') {
                return;
            }

            event.preventDefault();
            event.stopPropagation();

            if (target.classList.contains('verify-code')) {
                verifyCode(code.value);
            }
        }
        document.addEventListener('DOMContentLoaded', () => {
            document.addEventListener('click', handleButtonClickEvent);
        });
    </script>
{% endblock %}
